# FraudGuard Environment Configuration

# Application & Server
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Security & Secrets (Generate strong random secrets in production: openssl rand -hex 32)
SECRET_KEY=dev_fraudguard_super_secret_jwt_key_at_least_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite for local dev/test; can be PostgreSQL in staging/prod)
DATABASE_URL=sqlite:///./fraudguard.db

# Email / SMTP Settings (For Password Reset OTP Delivery)
# In development, set SMTP_ENABLED=False to print OTPs safely to server logs or test via dev mailbox
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@fraudguard.local
SMTP_FROM_NAME=FraudGuard Security Team

# Security Limits
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5

# Google OAuth 2.0 / OpenID Connect (OIDC) Settings
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# CORS Settings
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:5173", "http://localhost:3000"]
